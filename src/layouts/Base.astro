---
import {site, navGroups, mainNavLinks} from '../data';
import '../styles.css';
interface Props { title: string; description: string; image?: string; type?: 'website'|'article'; jsonLd?: Record<string,unknown>; noindex?: boolean }
const {title,description,image='/images/celebracao-comunidade.jpg',type='website',jsonLd,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).toString();
const fullTitle=title===site.name?`${site.name} — Brejetuba, ES`:(title.includes('Brejetuba')||title.includes('ES')?`${title} | ${site.short}`:`${title} | ${site.short} — Brejetuba, ES`);
const church={
  '@context':'https://schema.org',
  '@type':'Church',
  '@id':`${site.url}/#igreja`,
  name:site.name,
  alternateName:[site.short,'PIB Brejetuba'],
  description:site.slogan,
  url:site.url,
  image:`${site.url}/images/celebracao-comunidade.jpg`,
  logo:`${site.url}/images/logo.png`,
  telephone:site.phone,
  email:site.email,
  priceRange:'$',
  sameAs:[site.instagram],
  address:{
    '@type':'PostalAddress',
    streetAddress:'Av. Firmino Teixeira Griffo, 504 - Centro',
    addressLocality:'Brejetuba',
    addressRegion:'ES',
    postalCode:'29398-000',
    addressCountry:'BR'
  },
  geo:{
    '@type':'GeoCoordinates',
    latitude:-20.1432,
    longitude:-41.2937
  },
  openingHoursSpecification:[
    {'@type':'OpeningHoursSpecification',dayOfWeek:['Sunday'],opens:'08:00',closes:'10:00'},
    {'@type':'OpeningHoursSpecification',dayOfWeek:['Sunday'],opens:'19:00',closes:'21:00'},
    {'@type':'OpeningHoursSpecification',dayOfWeek:['Wednesday'],opens:'19:30',closes:'21:00'}
  ],
  hasMap:site.maps
};
const website={ '@context':'https://schema.org','@type':'WebSite','@id':`${site.url}/#website`,name:site.name,alternateName:site.short,url:`${site.url}/`};
---
<!doctype html><html lang="pt-BR"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{fullTitle}</title><meta name="description" content={description}/><meta name="theme-color" content="#25433d"/>
<link rel="canonical" href={canonical}/><link rel="icon" href="/images/logo.png" type="image/png"/>
{noindex && <meta name="robots" content="noindex,follow"/>}
<meta property="og:locale" content="pt_BR"/><meta property="og:site_name" content={site.name}/><meta property="og:type" content={type}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,site.url).toString()}/><meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={JSON.stringify(church).replace(/</g,'\\u003c')}/>
{Astro.url.pathname==='/' && <script type="application/ld+json" set:html={JSON.stringify(website).replace(/</g,'\\u003c')}/>}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g,'\\u003c')}/>}
</head><body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div class="topline"><div class="wrap">Uma comunidade de fé no coração de Brejetuba, ES <a href="/horarios-dos-cultos/">Veja nossos horários <span aria-hidden="true">↗</span></a></div></div>
<header class="header"><div class="wrap nav">
<a class="brand" href="/" aria-label="PIB Brejetuba — página inicial"><img class="brand-logo" src="/images/logo.png" width="366" height="462" alt="Logomarca da Primeira Igreja Batista em Brejetuba - ES"/><span>PRIMEIRA IGREJA BATISTA<small>EM BREJETUBA</small></span></a>
<nav aria-label="Navegação principal" class="desktop-nav">
  {navGroups.map(group => (
    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle" aria-expanded="false">
        {group.label}
        <svg class="dropdown-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="dropdown-menu">
        {group.items.map(item => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
    </div>
  ))}
  {mainNavLinks.map(l => (
    <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>
  ))}
</nav>
<div class="header-actions">
  <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Siga-nos no Instagram">
    <svg class="social-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
  </a>
  <a class="btn btn-small nav-cta" href="/contribua/">Contribua <span aria-hidden="true">↗</span></a>
</div>
<details class="mobile-menu">
  <summary aria-label="Abrir menu">Menu <span aria-hidden="true">☰</span></summary>
  <nav aria-label="Navegação móvel">
    <a href="/primeira-visita/" class="mobile-highlight">Primeira visita ↗</a>
    {navGroups.map(group => (
      <div class="mobile-group">
        <span class="mobile-group-title">{group.label}</span>
        {group.items.map(item => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
    ))}
    {mainNavLinks.map(l => (
      <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="mobile-social-link">
      <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      <span>Instagram da PIB Brejetuba ↗</span>
    </a>
    <a href="/contribua/" class="mobile-cta">Contribua (Dízimos e Ofertas) ↗</a>
  </nav>
</details>
</div></header>
<main id="conteudo"><slot/></main>
<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand footer-brand" href="/"><img class="brand-logo" src="/images/logo.png" width="366" height="462" alt="Logomarca oficial da Primeira Igreja Batista em Brejetuba - ES"/><span>PRIMEIRA IGREJA BATISTA<small>EM BREJETUBA</small></span></a>
      <p>{site.slogan}</p>
      <p>Uma comunidade para conhecer Jesus, crescer na Palavra e servir nossa cidade.</p>
      <div class="footer-affiliation" style="margin-top: 24px; padding-top: 18px; border-top: 1px solid #3d352e;">
        <span style="display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #a89a8c; margin-bottom: 12px; font-weight: 700;">Filiação / Igreja Cooperante</span>
        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
          <a href="https://convencaobatista.com.br/site/" target="_blank" rel="noopener noreferrer" style="display: inline-block; background: #fff; padding: 6px 10px; border-radius: 6px; transition: opacity 0.2s;" aria-label="Convenção Batista Brasileira (CBB)">
            <img src="/images/logo-cbb.png" alt="Convenção Batista Brasileira - CBB" style="height: 32px; width: auto; object-fit: contain;" />
          </a>
          <a href="https://www.batistas.es/" target="_blank" rel="noopener noreferrer" style="display: inline-block; background: #fff; padding: 6px 10px; border-radius: 6px; transition: opacity 0.2s;" aria-label="Convenção Batista do Estado do Espírito Santo (CBEES)">
            <img src="/images/logo-cbees.jpg" alt="Convenção Batista do Estado do Espírito Santo - CBEES" style="height: 32px; width: auto; object-fit: contain;" />
          </a>
        </div>
      </div>
    </div>
    <div>
      <h2>Encontre-nos</h2>
      <p>{site.address}</p>
      <a href={site.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp do Pastor Márcio: {site.phoneDisplay} ↗</a>
      <a href={`tel:${site.phone}`}>Ligar: {site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="footer-social-link">
        <svg class="social-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        <span>Instagram da PIB Brejetuba ↗</span>
      </a>
      <a href={site.maps} target="_blank" rel="noopener noreferrer">Abrir rota no Google Maps ↗</a>
      <p>Domingo: 08h e 19h<br/>Quarta-feira: 19h30</p>
    </div>
    <div>
      <h2>Explore</h2>
      <a href="/primeira-visita/">Sua primeira visita</a>
      <a href="/eventos/">Agenda</a>
      <a href="/lideranca/">Liderança</a>
      <a href="/galeria/">Galeria</a>
      <a href="/no-que-cremos/">No que cremos</a>
      <a href="/discipulado/">Discipulado</a>
      <a href="/oracao/">Oração</a>
      <a href="/artigos/">Artigos</a>
      <a href="/contribua/">Contribua</a>
      <a href="/privacidade/">Privacidade</a>
    </div>
    <div>
      <h2>Brejetuba e Região</h2>
      <a href="/igreja-em-brejetuba/">Igreja em Brejetuba</a>
      <a href="/igreja-batista-em-brejetuba/">Igreja Batista em Brejetuba</a>
      <a href="/cultos-em-brejetuba/">Cultos em Brejetuba</a>
      <a href="/estudo-biblico-em-brejetuba/">Estudo bíblico em Brejetuba</a>
      <a href="/historia-batista-em-brejetuba/">História Batista em Brejetuba</a>
      <a href="/batistas-no-espirito-santo/">Batistas no Espírito Santo</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getFullYear()} Primeira Igreja Batista em Brejetuba</span>
    <span>Brejetuba · Espírito Santo</span>
  </div>
</footer>
<a
  href={`https://wa.me/5527998738910?text=${encodeURIComponent('Olá, Pastor! Estive no site da PIB Brejetuba e gostaria de...')}`}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float"
  aria-label="Falar com o Pastor Márcio no WhatsApp"
>
  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 2C6.477 2 2 6.477 2 12c0 2.152.68 4.148 1.838 5.787L2.5 21.5l3.826-1.312A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.95 7.95 0 01-4.062-1.112l-.291-.173-2.274.78.795-2.218-.19-.302A7.956 7.956 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/>
  </svg>
</a>
</body></html>
