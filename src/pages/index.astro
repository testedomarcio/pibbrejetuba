---
import Base from '../layouts/Base.astro';
import {site} from '../data';
import {getCollection} from 'astro:content';
const artigos=(await getCollection('artigos',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
---
<Base title={site.name} description="Conheça a Primeira Igreja Batista em Brejetuba, ES. Escola Bíblica domingo às 08h, culto domingo às 19h e estudo bíblico quarta às 19h30. Venha nos visitar.">
<section class="hero"><div class="wrap"><span class="eyebrow">Brejetuba · Espírito Santo</span><h1>Um lugar para conhecer Jesus e caminhar em comunidade.</h1><p>Somos uma igreja apaixonada por Jesus, profunda em conhecimento e relevante para a cidade. Há um lugar para você aqui.</p><div class="actions"><a class="btn" href="/primeira-visita/">Planeje sua visita ↗</a><a class="btn btn-light" href={site.maps} target="_blank" rel="noopener noreferrer">Como chegar ↗</a></div><div class="hero-note"><span>✦ Domingo às 08h e 19h</span><span>✦ Quarta-feira às 19h30</span><span>✦ Centro de Brejetuba</span></div></div></section>
<section class="section"><div class="wrap split"><div><span class="eyebrow">Bem-vindo à nossa casa</span><h2>Você pode chegar como está.</h2><p>Talvez você já frequente uma igreja há anos. Talvez esteja pensando em entrar pela primeira vez. Queremos receber você, ouvir sua história e caminhar juntos na fé em Jesus.</p><p>Nossa comunidade se reúne para adorar, estudar a Bíblia, orar e servir Brejetuba. Traga sua família: será uma alegria conhecer vocês.</p><a class="btn" href="/primeira-visita/">Saiba como é a primeira visita ↗</a></div><img src="/images/louvor.png" alt="Equipe de louvor da igreja durante uma celebração" loading="lazy" width="1280" height="720"/></div></section>
<section class="section section-soft"><div class="wrap"><div class="section-head"><span class="eyebrow">Encontros durante a semana</span><h2>Encontre seu lugar à mesa.</h2><p>Há momentos para aprender, celebrar e criar vínculos. Confira os horários habituais dos nossos encontros.</p></div><div class="grid grid-3">{site.schedule.map(s=><div class="card"><span class="eyebrow">{s.day}</span><span class="num">{s.time}</span><h3>{s.name}</h3><a href="/horarios-dos-cultos/">Conheça os encontros ↗</a></div>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">Nossa caminhada</span><h2>Fé que se vive todos os dias.</h2><p>A igreja se reúne, aprende e leva o amor de Cristo para além das paredes do templo.</p></div><div class="grid grid-3"><div class="card"><span class="num">01</span><h3>Conheça a comunidade</h3><p>Saiba quem somos, o que cremos e por que estamos em Brejetuba.</p><a href="/quem-somos/">Nossa história ↗</a></div><div class="card"><span class="num">02</span><h3>Cresça na Palavra</h3><p>Estudos bíblicos, escola dominical e discipulado para cada etapa da caminhada.</p><a href="/estudos-biblicos/">Explore os estudos ↗</a></div><div class="card"><span class="num">03</span><h3>Caminhe com pessoas</h3><p>Oração, comunhão e oportunidades de servir lado a lado.</p><a href="/ministerios/">Conheça os ministérios ↗</a></div></div></div></section>
<section class="section section-dark"><div class="wrap split"><div><span class="eyebrow" style="color:#e7b089">Para quem está chegando</span><h2>Sua primeira visita pode ser o começo de uma nova história.</h2><p>Não precisa marcar horário nem saber tudo sobre a igreja. Veja o endereço, os horários e algumas respostas para chegar com tranquilidade.</p><a class="btn btn-light" href="/primeira-visita/">Quero visitar ↗</a></div><div class="quote">“Uma igreja apaixonada por Jesus, profunda em conhecimento e relevante para a cidade.”</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">Conhecimento para a caminhada</span><h2>Leia, reflita e cresça.</h2><p>Conteúdos bíblicos para levar a Palavra à vida cotidiana.</p></div><div class="grid grid-2">{artigos.map(a=><article class="card content-card"><time datetime={a.data.date.toISOString()}>{a.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time><h3><a href={`/artigos/${a.id}/`}>{a.data.title} ↗</a></h3><p>{a.data.description}</p></article>)}</div><p style="margin-top:25px"><a href="/artigos/">Ver todos os artigos ↗</a></p></div></section>
<section class="section section-soft"><div class="wrap split"><div><span class="eyebrow">Oração e acolhimento</span><h2>Podemos orar com você.</h2><p>Você não precisa atravessar sozinho os desafios da vida. Se deseja conversar, pedir oração ou conhecer a comunidade, venha nos encontrar em um dos cultos.</p><a class="btn" href="/oracao/">Saiba mais ↗</a></div><div class="card"><h3>Onde estamos</h3><p>{site.address}</p><p>Em frente ao Posto Pernambuco, no Centro.</p><a href={site.maps} target="_blank" rel="noopener noreferrer">Traçar rota no Google Maps ↗</a></div></div></section>
</Base>
