---
import Base from '../layouts/Base.astro';
import {site} from '../data';
import {getCollection} from 'astro:content';
const artigos=(await getCollection('artigos',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf() || (a.data.seriesOrder??999)-(b.data.seriesOrder??999)).slice(0,2);
---
<Base title={site.name} description="Igreja em Brejetuba, ES: conheça a Primeira Igreja Batista. Uma comunidade para viver um relacionamento com Jesus, crescer na Palavra e servir a cidade. Domingo 08h e 19h; quarta 19h30.">
<section class="hero"><div class="wrap"><span class="eyebrow">Igreja em Brejetuba · Espírito Santo</span><h1>Conhecer Jesus. Ser transformado por ele. Caminhar juntos.</h1><p>Na Primeira Igreja Batista em Brejetuba, queremos viver um relacionamento real com Jesus: a transformação começa no coração e alcança a família, as amizades e a nossa cidade.</p><div class="actions"><a class="btn" href="/primeira-visita/">Planeje sua visita ↗</a><a class="btn btn-light" href={site.maps} target="_blank" rel="noopener noreferrer">Como chegar ↗</a></div><div class="hero-note"><span>✦ Domingo às 08h e 19h</span><span>✦ Quarta-feira às 19h30</span><span>✦ Centro de Brejetuba</span></div></div></section>
<section class="section"><div class="wrap split"><div><span class="eyebrow">Bem-vindo à nossa casa</span><h2>Você pode chegar como está.</h2><p>Talvez você já frequente uma igreja há anos. Talvez esteja pensando em entrar pela primeira vez. Queremos receber você, ouvir sua história e caminhar juntos na fé em Jesus.</p><p>Reunimos pessoas do Centro e da zona rural de Brejetuba para adorar, estudar a Bíblia, orar e servir. A fé cresce em relacionamentos: há lugar para sua história e suas perguntas.</p><a class="btn" href="/primeira-visita/">Saiba como é a primeira visita ↗</a></div><img src="/images/igreja-reunida.jpg" alt="Comunidade reunida para o culto na PIB Brejetuba" loading="lazy" width="685" height="913"/></div></section>
<section class="section section-soft"><div class="wrap"><div class="section-head"><span class="eyebrow">Nossa forma de caminhar</span><h2>Uma fé que começa por dentro e aparece na vida.</h2><p>Seguimos Jesus juntos, aprendendo a ouvi-lo e a responder ao seu amor no cotidiano.</p></div><div class="grid grid-3"><div class="card"><span class="num">01</span><h3>Relacionamento com Jesus</h3><p>Antes de qualquer atividade, queremos conhecê-lo, permanecer nele e crescer na oração e na Palavra. Leia João 15:4–5.</p><a href="/no-que-cremos/">Conheça nossa fé ↗</a></div><div class="card"><span class="num">02</span><h3>Transformação de dentro para fora</h3><p>A graça de Deus renova nossos pensamentos, escolhas e atitudes. Crescer é um caminho de arrependimento, fé e obediência. Leia Romanos 12:2.</p><a href="/discipulado/">Como caminhamos ↗</a></div><div class="card"><span class="num">03</span><h3>Uma vida para servir</h3><p>Ninguém caminha sozinho. Na igreja aprendemos a amar pessoas e a levar o cuidado de Jesus para Brejetuba. Leia Marcos 10:45.</p><a href="/quem-somos/">Conheça a comunidade ↗</a></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">Encontros durante a semana</span><h2>Encontre seu lugar à mesa.</h2><p>Há momentos para aprender, celebrar e criar vínculos. Confira os horários habituais dos nossos encontros.</p></div><div class="grid grid-3">{site.schedule.map(s=><div class="card"><span class="eyebrow">{s.day}</span><span class="num">{s.time}</span><h3>{s.name}</h3><a href="/horarios-dos-cultos/">Conheça os encontros ↗</a></div>)}</div></div></section>
<section class="section section-soft"><div class="wrap"><div class="section-head"><span class="eyebrow">Nossa caminhada</span><h2>Fé que se vive todos os dias.</h2><p>A igreja se reúne, aprende e leva o amor de Cristo para além das paredes do templo.</p></div><div class="grid grid-3"><div class="card"><span class="num">01</span><h3>Conheça a comunidade</h3><p>Saiba quem somos, o que cremos e por que estamos em Brejetuba.</p><a href="/quem-somos/">Nossa história ↗</a></div><div class="card"><span class="num">02</span><h3>Cresça na Palavra</h3><p>Estudos bíblicos, escola dominical e discipulado para cada etapa da caminhada.</p><a href="/estudos-biblicos/">Explore os estudos ↗</a></div><div class="card"><span class="num">03</span><h3>Caminhe com pessoas</h3><p>Oração, comunhão e oportunidades de servir lado a lado.</p><a href="/ministerios/">Conheça os ministérios ↗</a></div></div></div></section>
<section class="section section-dark"><div class="wrap split"><div><span class="eyebrow" style="color:#e7b089">Para quem está chegando</span><h2>Sua primeira visita pode ser o começo de uma nova história.</h2><p>Não precisa marcar horário nem saber tudo sobre a igreja. Veja o endereço, os horários e algumas respostas para chegar com tranquilidade.</p><a class="btn btn-light" href="/primeira-visita/">Quero visitar ↗</a></div><div class="quote">“Uma igreja apaixonada por Jesus, profunda em conhecimento e relevante para a cidade.”</div></div></section>
<section class="section"><div class="wrap"><div class="section-head"><span class="eyebrow">Conhecimento para a caminhada</span><h2>Leia, reflita e cresça.</h2><p>Conteúdos bíblicos para levar a Palavra à vida cotidiana.</p></div><div class="grid grid-2">{artigos.map(a=><article class="card content-card"><time datetime={a.data.date.toISOString()}>{a.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time><h3><a href={`/artigos/${a.id}/`}>{a.data.title} ↗</a></h3><p>{a.data.description}</p></article>)}</div><p style="margin-top:25px"><a href="/artigos/estudos-de-quarta-feira/">Conheça os Estudos de Quarta-feira ↗</a> · <a href="/artigos/">Ver todos os artigos ↗</a></p></div></section>
<section class="section section-soft"><div class="wrap split"><div><span class="eyebrow">Oração e acolhimento</span><h2>Podemos orar com você.</h2><p>Você não precisa atravessar sozinho os desafios da vida. Se deseja conversar, pedir oração ou conhecer a comunidade, venha nos encontrar em um dos cultos.</p><a class="btn" href="/oracao/">Saiba mais ↗</a></div><div class="card"><h3>Onde estamos</h3><p>{site.address}</p><p>Em frente ao Posto Pernambuco, no Centro.</p><a href={site.maps} target="_blank" rel="noopener noreferrer">Traçar rota no Google Maps ↗</a><p><a href={site.whatsapp} target="_blank" rel="noopener noreferrer">Converse com o Pastor Márcio no WhatsApp ↗</a></p><p><a href={site.instagram} target="_blank" rel="noopener noreferrer">Acompanhe nosso Instagram ↗</a></p></div></div></section>
</Base>
