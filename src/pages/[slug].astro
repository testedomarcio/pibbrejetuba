---
import Base from '../layouts/Base.astro';
import {site} from '../data';
import {pages} from '../page-data';
import {galleryImages} from '../gallery';

export function getStaticPaths(){return Object.entries(pages).map(([slug,page])=>({params:{slug},props:{page}}))}
const {page}=Astro.props;
const slug=Astro.params.slug;
const isGallery=slug==='galeria';
---
<Base title={page.title} description={page.description}>
<div class="page-hero"><div class="wrap"><div class="bread"><a href="/">Início</a> / {page.title}</div><span class="eyebrow">{page.eyebrow}</span><h1>{page.title}</h1><p>{page.intro}</p></div></div>
<section class="section"><div class="wrap"><div class="prose">{page.sections.map(s=><section><h2>{s.heading}</h2><p>{s.body}</p>{s.link&&<p><a href={s.link.href} target={s.link.href.startsWith('http')?'_blank':undefined} rel={s.link.href.startsWith('http')?'noopener noreferrer':undefined}>{s.link.label} ↗</a></p>}</section>)}</div>{page.timeline && <div class="history-wrap"><div class="section-head"><span class="eyebrow">Marcos da caminhada</span><h2>Uma história que segue sendo escrita</h2></div><ol class="history-timeline">{page.timeline.map(point=><li><span class="history-year">{point.year}</span><div><h3>{point.title}</h3><p>{point.body}</p></div></li>)}</ol></div>}{isGallery && <div class="gallery-grid">{galleryImages.map(photo=><figure><img src={photo.src} alt={photo.alt} loading="lazy" width="685" height="913"/><figcaption>{photo.caption}</figcaption></figure>)}</div>}<div class="cta-panel center"><h2>Há um lugar para você aqui.</h2><p>Conheça nossa comunidade pessoalmente em Brejetuba.</p><div class="actions"><a class="btn" href="/primeira-visita/">Planeje sua visita ↗</a><a class="btn btn-light" href={site.maps} target="_blank" rel="noopener noreferrer">Como chegar ↗</a></div></div></div></section>
</Base>
