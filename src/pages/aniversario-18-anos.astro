---
import Base from '../layouts/Base.astro';
import {site} from '../data';

const title='18 anos da PIB Brejetuba — Ano da maturidade';
const description='Celebre os 18 anos da Primeira Igreja Batista em Brejetuba, ES, em 21 e 22 de novembro de 2026. Sábado às 19h com Ministério Fortaleza de Adoração e Pr. Amaury Bertoqui; domingo às 09h e 19h.';
const url=`${site.url}/aniversario-18-anos/`;
const eventLocation={
  '@type':'Place',name:site.name,url:site.url,
  address:{'@type':'PostalAddress',streetAddress:'Av. Firmino Teixeira Griffo, 504',addressLocality:'Brejetuba',addressRegion:'ES',postalCode:'29630-000',addressCountry:'BR'}
};
const jsonLd={
  '@context':'https://schema.org','@type':'ItemList',name:'Programação dos 18 anos da Primeira Igreja Batista em Brejetuba',url,
  itemListElement:[
    {'@type':'ListItem',position:1,item:{'@type':'Event',name:'18 anos — noite de louvor com Ministério Fortaleza de Adoração e Pr. Amaury Bertoqui',startDate:'2026-11-21T19:00:00-03:00',eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',location:eventLocation,performer:[{'@type':'MusicGroup',name:'Ministério Fortaleza de Adoração'},{'@type':'Person',name:'Pr. Amaury Bertoqui'}],image:`${site.url}/images/amaury-bertoqui-18-anos.webp`,url:`${url}#sabado`}},
    {'@type':'ListItem',position:2,item:{'@type':'Event',name:'18 anos — celebração da Ceia do Senhor',startDate:'2026-11-22T09:00:00-03:00',eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',location:eventLocation,organizer:{'@type':'Church',name:site.name,url:site.url},url:`${url}#domingo-manha`}},
    {'@type':'ListItem',position:3,item:{'@type':'Event',name:'18 anos — Celebração da Saudade',startDate:'2026-11-22T19:00:00-03:00',eventStatus:'https://schema.org/EventScheduled',eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',location:eventLocation,performer:{'@type':'MusicGroup',name:'Ministério de Louvor da Primeira Igreja Batista em Brejetuba'},url:`${url}#domingo-noite`}}
  ]
};
---
<Base title={title} description={description} image="/images/amaury-bertoqui-18-anos.webp" jsonLd={jsonLd}>
  <section class="anniversary-hero">
    <div class="wrap anniversary-hero-grid">
      <div class="anniversary-intro">
        <span class="anniversary-kicker">Primeira Igreja Batista em Brejetuba · 21 e 22 de novembro de 2026</span>
        <span class="anniversary-big-number" aria-hidden="true">18<span>anos</span></span>
        <h1>18 anos. Ano da maturidade.</h1>
        <p>Uma história que começou antes de 2008, cresceu em Brejetuba e continua apontando para Jesus. Venha celebrar conosco dois dias de gratidão, louvor e comunhão.</p>
        <div class="actions"><a class="btn" href="#programacao">Veja a programação ↓</a><a class="btn btn-light" href={site.maps} target="_blank" rel="noopener noreferrer">Como chegar ↗</a></div>
        <span class="anniversary-hero-foot">Sábado, 21/11, às 19h · Domingo, 22/11, às 09h e 19h</span>
      </div>
      <figure class="anniversary-portrait"><img src="/images/amaury-bertoqui-18-anos.webp" width="1115" height="1536" alt="Pr. Amaury Bertoqui ministrando com microfone" fetchpriority="high"/><figcaption>Pr. Amaury Bertoqui · convidado de sábado</figcaption></figure>
    </div>
  </section>

  <section class="section anniversary-opening"><div class="wrap split"><div><span class="eyebrow">O convite</span><h2>18 anos de história. Um novo tempo de amadurecer.</h2><p>Nossa caminhada foi construída por pessoas que oraram, serviram, ensinaram e anunciaram o evangelho em Brejetuba. Celebrar é agradecer pelo que Deus fez e renovar o compromisso de seguir Jesus com uma fé que amadurece e se torna visível no amor ao próximo.</p><p>Se você fez parte dessa história ou deseja conhecer a igreja agora, este convite também é para você. Traga sua família e participe dos encontros.</p></div><div class="anniversary-verse"><span>O tema</span><p>“18 anos.<br/>Ano da maturidade.”</p><small>Conhecer Jesus, crescer na Palavra e servir a cidade.</small></div></div></section>

  <section class="section section-soft" id="programacao"><div class="wrap"><div class="section-head"><span class="eyebrow">Três encontros · dois dias</span><h2>Programação da celebração</h2><p>Todos os encontros serão na Primeira Igreja Batista em Brejetuba, no Centro, em frente ao Posto Pernambuco.</p></div><div class="anniversary-schedule">
    <article class="anniversary-event" id="sabado"><div class="anniversary-when"><span>Sábado</span><strong>21</strong><span>novembro · 19h</span></div><div><span class="eyebrow">Noite de abertura</span><h3>Louvor com banda completa</h3><p>Receberemos o Ministério Fortaleza de Adoração, de Cachoeiro de Itapemirim, com a participação do cantor e pregador <strong>Pr. Amaury Bertoqui</strong>. O ministério também é conhecido por sua trajetória como Ministério de Louvor Hebrom.</p><div class="anniversary-inline-links"><a href="https://www.instagram.com/pramaurybertoqui/" target="_blank" rel="noopener noreferrer">Instagram do Pr. Amaury ↗</a><a href="https://www.youtube.com/c/pramaurybertoqui" target="_blank" rel="noopener noreferrer">Vídeos no YouTube ↗</a><a href="https://open.spotify.com/artist/3nvgiSk0r6RYtFLZRPK3nf" target="_blank" rel="noopener noreferrer">Ouça no Spotify ↗</a></div></div></article>
    <article class="anniversary-event" id="domingo-manha"><div class="anniversary-when"><span>Domingo</span><strong>22</strong><span>novembro · 09h</span></div><div><span class="eyebrow">Celebração pela manhã</span><h3>Ceia do Senhor</h3><p>Uma manhã para nos reunirmos à mesa, lembrarmos de Jesus e agradecermos por sua graça ao longo dessa caminhada.</p></div></article>
    <article class="anniversary-event" id="domingo-noite"><div class="anniversary-when"><span>Domingo</span><strong>22</strong><span>novembro · 19h</span></div><div><span class="eyebrow">Celebração de encerramento</span><h3>Celebração da Saudade</h3><p>Uma noite com o Ministério de Louvor da Primeira Igreja Batista em Brejetuba e convidados, para celebrar nossa história em comunhão e adoração.</p></div></article>
  </div></div></section>

  <section class="section anniversary-story"><div class="wrap split"><div><span class="eyebrow">Nossa história</span><h2>Antes de ser igreja organizada, já havia uma missão.</h2><p>A comunidade cristã que hoje conhecemos como Primeira Igreja Batista em Brejetuba esteve presente na cidade durante anos como <strong>Missão Batista</strong>, congregação da <strong>Primeira Igreja Batista em Alto Firme</strong>. Sua história começou antes da data que celebramos como aniversário.</p><p>Em <strong>15 de novembro de 2008</strong>, a missão se emancipou e se organizou como igreja. Em 2026, completamos 18 anos dessa etapa da caminhada. Reconhecemos com gratidão as pessoas que vieram antes de nós e olhamos para frente, desejando amadurecer no relacionamento com Jesus, no conhecimento da Palavra e no serviço a Brejetuba.</p><a href="/nossa-historia/">Conheça mais sobre a igreja ↗</a></div><img src="/images/igreja-reunida.jpg" width="685" height="913" alt="Comunidade da Primeira Igreja Batista em Brejetuba reunida" loading="lazy"/></div></section>

  <section class="section section-dark"><div class="wrap split anniversary-artist"><div><span class="eyebrow">Convidado de sábado</span><h2>Pr. Amaury Bertoqui e Ministério Fortaleza de Adoração</h2><p>O cantor e pregador vem de Cachoeiro de Itapemirim com a banda completa para a noite de 21 de novembro, às 19h. Conheça algumas de suas canções antes de participar com a gente.</p><div class="actions"><a class="btn btn-light" href="https://open.spotify.com/artist/3nvgiSk0r6RYtFLZRPK3nf" target="_blank" rel="noopener noreferrer">Ouvir no Spotify ↗</a><a class="btn btn-outline-light" href="https://www.youtube.com/c/pramaurybertoqui" target="_blank" rel="noopener noreferrer">Assistir no YouTube ↗</a></div></div><img class="anniversary-artist-photo" src="/images/amaury-bertoqui-louvor.webp" width="1536" height="1536" alt="Pr. Amaury Bertoqui cantando durante uma apresentação" loading="lazy"/></div></section>

  <section class="section anniversary-visit"><div class="wrap"><div class="section-head"><span class="eyebrow">Venha celebrar conosco</span><h2>Estamos esperando você em Brejetuba.</h2><p>Av. Firmino Teixeira Griffo, 504 — Centro, Brejetuba — ES. Em frente ao Posto Pernambuco.</p></div><div class="actions"><a class="btn" href={site.maps} target="_blank" rel="noopener noreferrer">Traçar rota ↗</a><a class="btn btn-light" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Tirar uma dúvida no WhatsApp ↗</a><a class="btn btn-light" href="/primeira-visita/">É minha primeira visita ↗</a></div><p class="anniversary-share"><button type="button" id="compartilhar-aniversario">Compartilhar este convite ↗</button><span id="compartilhar-retorno" role="status" aria-live="polite"></span></p></div></section>
  <script>
    const button=document.getElementById('compartilhar-aniversario');
    button?.addEventListener('click',async()=>{
      const message='18 anos da Primeira Igreja Batista em Brejetuba — Ano da maturidade. 21 e 22 de novembro de 2026. Confira a programação:';
      try{
        if(navigator.share)await navigator.share({title:'18 anos da PIB Brejetuba',text:message,url:location.href});
        else{await navigator.clipboard.writeText(`${message} ${location.href}`);const status=document.getElementById('compartilhar-retorno');if(status)status.textContent=' Link copiado!'}
      }catch(error){if((error as DOMException).name!=='AbortError'){const status=document.getElementById('compartilhar-retorno');if(status)status.textContent=' Copie o endereço desta página para compartilhar.'}}
    });
  </script>
</Base>
