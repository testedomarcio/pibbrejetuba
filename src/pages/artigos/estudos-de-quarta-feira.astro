---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
import {site} from '../../data';

const estudos = (await getCollection('artigos', ({data}) => !data.draft && data.category === 'Estudos de Quarta-feira'))
  .sort((a,b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
---
<Base title="Estudos de Quarta-feira — PIB Brejetuba (ES)" description="Série de 5 estudos bíblicos no culto de ensino das quartas-feiras (19h30) na Primeira Igreja Batista em Brejetuba - ES. Aprenda a Palavra conosco.">
  <div class="page-hero"><div class="wrap"><div class="bread"><a href="/">Início</a> / <a href="/artigos/">Artigos</a> / Estudos de Quarta-feira</div><span class="eyebrow">Estudo Bíblico em Brejetuba · ES</span><h1>Estudos de Quarta-feira na PIB Brejetuba</h1><p>Cinco reflexões bíblicas sobre quem é Jesus e o que significa viver em Cristo. A série acompanha os primeiros capítulos de <em>A Vida em Cristo</em>, de John Stott, para ser praticada no dia a dia em Brejetuba, Espírito Santo.</p></div></div>
  <section class="section"><div class="wrap"><div class="series-banner"><div><span class="eyebrow">Venha estudar com a gente em Brejetuba - ES</span><h2>A leitura continua em nossos encontros semanais.</h2><p>Toda quarta-feira, às 19h30, no culto de ensino da PIB Brejetuba. {site.address}, em frente ao Posto Pernambuco. Traga suas perguntas e participe.</p></div><a class="btn" href="/primeira-visita/">Como participar ↗</a></div><div class="grid grid-2">{estudos.map(estudo => <article class="card series-item"><span class="num">{String(estudo.data.seriesOrder).padStart(2,'0')}</span><div><span class="eyebrow">Estudo {estudo.data.seriesOrder} de 5</span><h2><a href={`/artigos/${estudo.id}/`}>{estudo.data.title} ↗</a></h2><p>{estudo.data.description}</p></div></article>)}</div></div></section>
</Base>
