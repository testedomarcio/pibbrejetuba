---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
const titles={artigos:'Artigos',mensagens:'Mensagens',eventos:'Eventos'} as const;
const intros={artigos:'Textos bíblicos para estudar, refletir e aplicar à vida.',mensagens:'Pregações e reflexões da caminhada da nossa igreja.',eventos:'Programações e encontros da nossa comunidade.'} as const;
export async function getStaticPaths(){return await Promise.all((['artigos','mensagens','eventos'] as const).map(async collection=>({params:{collection},props:{items:(await getCollection(collection,({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf() || (a.data.seriesOrder??999)-(b.data.seriesOrder??999))}})))}
const collection=Astro.params.collection as keyof typeof titles;
const {items}=Astro.props;
if(collection==='eventos') items.sort((a:any,b:any)=>a.data.date.valueOf()-b.data.date.valueOf());
---
<Base title={titles[collection]} description={`${intros[collection]} Primeira Igreja Batista em Brejetuba, Espírito Santo.`}><div class="page-hero"><div class="wrap"><span class="eyebrow">Conhecimento e comunidade</span><h1>{titles[collection]}</h1><p>{intros[collection]}</p></div></div><section class="section"><div class="wrap">{collection==='artigos'&&<div class="series-banner"><div><span class="eyebrow">Categorias</span><h2>Estudos de Quarta-feira</h2><p>Uma caminhada pelos primeiros capítulos de <em>A Vida em Cristo</em>, de John Stott. Leia em casa e venha conversar sobre a Bíblia conosco.</p></div><a class="btn" href="/artigos/estudos-de-quarta-feira/">Ver os cinco estudos ↗</a></div>}<div class="grid grid-2">{items.length?items.map((item:any)=><article class="card content-card" data-event-end={collection==='eventos'?(item.data.endDate??item.data.date).toISOString().slice(0,10):undefined}>{item.data.category==='Estudos de Quarta-feira'?<a class="content-category" href="/artigos/estudos-de-quarta-feira/">{item.data.category}</a>:item.data.category&&<span class="content-category">{item.data.category}</span>}<time datetime={item.data.date.toISOString()}>{collection==='eventos'?(item.data.timeLabel??item.data.date.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'})):item.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})}</time><h3><a href={`/${collection}/${item.id}/`}>{item.data.title} ↗</a></h3><p>{item.data.description}</p></article>):<div class="card"><h2>Em breve</h2><p>Estamos organizando os conteúdos desta seção. Enquanto isso, veja nossos horários e venha participar pessoalmente.</p><a href="/horarios-dos-cultos/">Horários dos cultos ↗</a></div>}</div></div></section>{collection==='eventos'&&<script>const today=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());document.querySelectorAll<HTMLElement>('[data-event-end]').forEach(card=>{if((card.dataset.eventEnd??'')<today)card.remove()});</script>}</Base>
