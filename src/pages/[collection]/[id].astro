---
import Base from '../../layouts/Base.astro';import {getCollection,render} from 'astro:content';import {site} from '../../data';
export async function getStaticPaths(){const result=[];for(const collection of ['artigos','mensagens','eventos'] as const){for(const item of await getCollection(collection,({data})=>!data.draft)){result.push({params:{collection,id:item.id},props:{item,collection}})}}return result}
const {item,collection}=Astro.props;const eventData=collection==='eventos'?(item.data as {date:Date;endDate?:Date;timeLabel?:string}):null;const {Content}=await render(item);const url=`${site.url}/${collection}/${item.id}/`;
const schema={ '@context':'https://schema.org','@type':collection==='eventos'?'Event':'Article',headline:item.data.title,description:item.data.description,datePublished:item.data.date.toISOString(),author:{'@type':'Organization',name:item.data.author},mainEntityOfPage:url,...(collection==='eventos'?{name:item.data.title,startDate:eventData?.endDate?eventData.date.toISOString().slice(0,10):eventData?.date.toISOString(),...(eventData?.endDate?{endDate:eventData.endDate.toISOString().slice(0,10)}:{}),location:{'@type':'Place',name:site.name,address:site.address}}:{})};
---
<Base title={item.data.title} description={item.data.description} type="article" jsonLd={schema}><div class="page-hero"><div class="wrap"><div class="bread"><a href="/">Início</a> / <a href={`/${collection}/`}>{collection}</a> {item.data.category==='Estudos de Quarta-feira'&&<> / <a href="/artigos/estudos-de-quarta-feira/">{item.data.category}</a></>} / {item.data.title}</div><span class="eyebrow">{item.data.category ? `${item.data.category} · ` : ''}{collection==='eventos'?(eventData?.timeLabel??item.data.date.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'})):item.data.date.toLocaleDateString('pt-BR',{timeZone:'UTC'})} · {item.data.author}</span><h1>{item.data.title}</h1><p>{item.data.description}</p></div></div><section class="section"><article class="wrap prose"><Content/><div class="cta-panel"><h2>Continue a conversa.</h2><p>{item.data.category==='Estudos de Quarta-feira'?'Às quartas-feiras, às 19h30, estudamos a Bíblia juntos na PIB Brejetuba. Venha com suas perguntas e participe pessoalmente.':'Estude a Bíblia com a gente e conheça nossa comunidade.'}</p><a class="btn" href="/primeira-visita/">Planeje sua visita ↗</a></div></article></section></Base>
